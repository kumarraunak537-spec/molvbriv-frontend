# Molvbriv Backend Server Environment Variables
PORT=5000

# Razorpay Keys (Keep secret, never share on frontend)
# Use your Razorpay Dashboard values here:
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Supabase Admin Settings
SUPABASE_URL=https://your-project-id.supabase.co
# REQUIRED FOR BACKEND OPERATIONS (Bypasses RLS to insert verified orders)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Email SMTP Settings (For order invoice notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password_here
EMAIL_FROM=MOLVBRIV Concierge <your_email@gmail.com>
